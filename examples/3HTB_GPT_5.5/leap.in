source leaprc.protein.ff14SB
source leaprc.gaff
source leaprc.water.tip3p

# Map PDB atom names to template atom names
addPdbAtomMap { { "CH3"  "C" } { "HH31" "H1" } { "HH32" "H2" } { "HH33" "H3" } { "CL1" "Cl1" } { "CL2" "Cl2" } }

# Load ligand parameters
loadamberprep /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/JZ4_h.prepi
loadamberparams /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/JZ4_h.frcmod

# PDBFILE already has sandbox path
mol = loadpdb /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/complex.pdb
solvatebox mol TIP3PBOX 16
addions mol Cl- 0 # Neutralize system
addions mol Na+ 0 # Neutralize system

saveamberparm mol /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/complex.prmtop /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/complex.inpcrd
savepdb mol /home/hackathon/DynaMate_salome/sandbox/run_20260508_164924/complex_tleap.pdb

quit
